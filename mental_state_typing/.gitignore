# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
.venv/
venv/
ENV/
env/

# Environment variables & secrets
.env
*.env
.streamlit/secrets.toml
.streamlit/secrets.*

# SQLite local database files
*.db
*.sqlite
*.sqlite3
database/*.db
database/*.sqlite3

# Model checkpoints & serialized weights
models/*.h5
models/*.keras
models/*.pt
models/*.pth
models/*.pkl
models/*.joblib
!models/.gitkeep

# Datasets (protect raw participant timing records)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# IDEs & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
