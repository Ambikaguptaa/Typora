# Environment Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Local SQLite Database Path (relative to project root or absolute)
DATABASE_PATH=database/mental_state.db

# Storage Paths
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
SAMPLE_DATA_PATH=data/sample
MODELS_PATH=models

# Privacy & Security
PSEUDONYMIZATION_SALT=academic_research_salt_change_me_in_prod
PSEUDONYMIZATION_SECRET=academic_research_hmac_secret_change_in_production
# Fernet Encryption Key (generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Differential Privacy
DP_ENABLED=True
DP_EPSILON=1.0

# Data Retention Schedules (Days)
RAW_EVENT_RETENTION_DAYS=7
SESSION_RETENTION_DAYS=90
ASSESSMENT_RETENTION_DAYS=180
